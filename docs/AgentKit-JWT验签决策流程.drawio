<mxfile host="app.diagrams.net" agent="AgentKit-verification" version="24.0.0">
  <diagram name="JWT验签决策流程" id="agentkit-jwt-flow">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="AgentKit 网关 JWT 验签决策流程 (自查用)&#10;custom_jwt Runtime — 每个入站请求的判定路径" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="220" y="16" width="480" height="50" as="geometry" />
        </mxCell>

        <!-- 起点 -->
        <mxCell id="start" value="入站请求&#10;POST /invocations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="90" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- 判断1: 有无 Authorization -->
        <mxCell id="d1" value="携带&#10;Authorization: Bearer ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="180" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- 判断2: 签名/结构有效 -->
        <mxCell id="d2" value="JWKS 验签: 签名 + 结构&#10;(RS256, 从 discovery 拉公钥)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="330" width="240" height="100" as="geometry" />
        </mxCell>

        <!-- 判断3: iss/aud/exp -->
        <mxCell id="d3" value="声明校验&#10;iss = 用户池 issuer&#10;exp 未过期 / nbf 已生效" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="480" width="240" height="110" as="geometry" />
        </mxCell>

        <!-- 判断4: client 白名单 -->
        <mxCell id="d4" value="client_id / aud&#10;∈ allowed_clients 白名单 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="640" width="240" height="110" as="geometry" />
        </mxCell>

        <!-- 放行 -->
        <mxCell id="pass" value="放行: 透传 Header 进容器&#10;(Authorization / user_id / session_id)&#10;→ 200 (echo 或 agent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="800" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- 拒绝(共用) -->
        <mxCell id="deny" value="拒绝 → 401&#10;JWT authentication failed.&#10;(网关层文案, 请求不进容器)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="380" width="210" height="80" as="geometry" />
        </mxCell>

        <!-- ===================== 连线 ===================== -->
        <mxCell id="c0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="start" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="c1y" value="有" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c1n" value="无" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;strokeColor=#b85450;" edge="1" parent="1" source="d1" target="deny"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="c2y" value="有效" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2n" value="失败" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;strokeColor=#b85450;" edge="1" parent="1" source="d2" target="deny"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="c3y" value="通过" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c3n" value="iss 不符 / 已过期" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;strokeColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="d3" target="deny"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="765" y="535" /></Array></mxGeometry></mxCell>

        <mxCell id="c4y" value="在白名单" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="d4" target="pass"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c4n" value="不在白名单" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;strokeColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="d4" target="deny"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="765" y="695" /></Array></mxGeometry></mxCell>

        <!-- ===================== 测试用例落点 ===================== -->
        <mxCell id="caseTitle" value="本次验证用例落点" style="text;html=1;align=left;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="260" height="20" as="geometry" />
        </mxCell>
        <mxCell id="caseA" value="用例A 有效 token&#10;→ 全程通过 → 放行 200" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="810" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="caseB" value="用例B 无 token&#10;→ 判断1 &quot;无&quot; → 401" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="caseC" value="用例C 伪造 token&#10;→ 判断2 &quot;失败&quot; → 401" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- 落点虚线 -->
        <mxCell id="lca" style="edgeStyle=none;html=1;dashed=1;endArrow=open;strokeColor=#82b366;" edge="1" parent="1" source="caseA" target="pass"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lcb" style="edgeStyle=none;html=1;dashed=1;endArrow=open;strokeColor=#b85450;" edge="1" parent="1" source="caseB" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lcc" style="edgeStyle=none;html=1;dashed=1;endArrow=open;strokeColor=#b85450;" edge="1" parent="1" source="caseC" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===================== 自查说明 ===================== -->
        <mxCell id="selfcheck" value="日后自查: 若任一非法用例(无 token / 过期 / 白名单外)返回 200 并带出容器 body, 说明验签失效, 属严重漏洞。&#10;正确行为恒为: 唯有全程通过才 200, 其余一律 401 且请求不触达容器。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="920" width="830" height="50" as="geometry" />
        </mxCell>

        <!-- ===================== 可信性边界说明 ===================== -->
        <mxCell id="trust" value="边界: 网关按 token 放行后透传的 user_id 目前来自调用方自带 Header (非 token 派生)。&#10;&quot;防冒充&quot;需在客户应用层用 S2S token 兑换(client_credentials + target_user_id)把身份签进 token, 属客户自建、非 AgentKit 能力。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="985" width="830" height="55" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
