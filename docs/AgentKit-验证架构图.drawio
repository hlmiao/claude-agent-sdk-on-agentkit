        <mxCell id="ll4" edge="1" parent="1" source="l4" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#BD7000;endArrow=none;strokeWidth=1.5;fillColor=#f0a30a;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="litellm">
