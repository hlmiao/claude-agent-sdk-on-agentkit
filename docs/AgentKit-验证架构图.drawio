        <mxCell id="opsTitle" parent="1" style="text;html=1;align=left;fontStyle=1;fontSize=13;" value="关键运维要点 (复制部署必读)" vertex="1">
          <mxGeometry height="24" width="380" x="120" y="810" as="geometry" />
        </mxCell>
        <mxCell id="ops1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="① IS_SANDBOX=1 是 L4 硬前提&#xa;veFaaS 以 root 启动容器，Claude Code CLI 在 root 下拒绝 bypassPermissions (exit 1)。&#xa;注入 IS_SANDBOX=1 绕过；最稳做法是写进 Dockerfile 的 ENV。&#xa;判据: /invoke-debug exit_code 由 1 变 0、stdout 出现模型回复。" vertex="1">
          <mxGeometry height="90" width="380" x="120" y="840" as="geometry" />
        </mxCell>
        <mxCell id="ops2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="② 热实例陈旧陷阱&#xa;MinInstance:0 时 update+release 不立即作用于保温中的旧实例，&#xa;紧接着的请求可能命中旧实例，误判为配置未生效。&#xa;需静默等待冷启动，等待期间勿反复请求 (每次请求都会续命旧实例)。" vertex="1">
          <mxGeometry height="90" width="380" x="520" y="840" as="geometry" />
        </mxCell>
        <mxCell id="ops3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="③ 环境变量注入约束&#xa;ANTHROPIC_AUTH_TOKEN 须为 sk- 开头的纯 ASCII Virtual Key；&#xa;runtime update --envs-json 为整体替换 (须带全套 env)；&#xa;改 env 后必须 runtime release 才下发到实例。" vertex="1">
          <mxGeometry height="90" width="320" x="920" y="840" as="geometry" />
        </mxCell>
        <mxCell id="scope" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle;dashed=1;" value="未覆盖 (据实标注): 透传身份的&quot;可信性&quot;未验证 — 当前 user_id 由调用方 Header 自带、非 token 派生。&#xa;防冒充需客户应用层做 S2S token 兑换 (client_credentials + target_user_id)，属客户自建、非 AgentKit 能力。" vertex="1">
          <mxGeometry height="45" width="1120" x="120" y="945" as="geometry" />
        </mxCell>
