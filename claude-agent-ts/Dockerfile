# Claude Agent SDK (TypeScript) 容器 — 自定义 Dockerfile
# 注意：本文件刻意不含 AgentKit 的 "AUTO-GENERATED by AgentKit" 头注释，
# 因此 AgentKit 会识别为用户自定义 Dockerfile 并原样使用、不覆盖（源码 manager.py 已验证）。

FROM node:20-bookworm-slim

# Claude Agent SDK 底层驱动 Claude Code CLI 二进制，需全局安装
RUN npm install -g @anthropic-ai/claude-code

WORKDIR /app

# 先装依赖（利用层缓存）
COPY package.json package-lock.json* ./
RUN npm install

# 拷贝源码并编译 TypeScript
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

# 契约：容器监听 8000
ENV PORT=8000
EXPOSE 8000

# Claude Code CLI 拒绝在 root 下使用 --dangerously-skip-permissions（安全限制）。
# 容器安全最佳实践本就应以非 root 运行，这里创建专用用户并切换。
# 同时准备可写的 HOME / 配置目录（serverless 根文件系统可能只读）。
RUN useradd -m -u 10001 appuser \
    && mkdir -p /home/appuser/.claude \
    && chown -R appuser:appuser /home/appuser /app
ENV HOME=/home/appuser
ENV CLAUDE_CONFIG_DIR=/home/appuser/.claude
USER appuser

CMD ["node", "dist/server.js"]
